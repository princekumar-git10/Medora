rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isRole(role) {
      return isAuthenticated() && getUserData().role == role;
    }

    function isAccountActive() {
      return isAuthenticated() && getUserData().accountStatus == 'ACTIVE';
    }

    function isAdmin() {
      return isAuthenticated() && (
        getUserData().role == 'admin' || 
        request.auth.token.email.matches('.*admin@medisync[.]ai.*')
      );
    }

    function isDoctor() {
      return isRole('doctor') && isAccountActive();
    }

    function isHospital() {
      return isRole('hospital') && isAccountActive();
    }

    function isPatient() {
      return isRole('patient');
    }

    // Users Collection: Users can read and update their own profile; Admins have full access
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // Doctors Collection: Verified doctors can read/update their profile; Admins manage verification
    match /doctors/{doctorId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (request.auth.uid == doctorId || isAdmin());
      allow update: if isAuthenticated() && (request.auth.uid == doctorId || isAdmin());
      allow delete: if isAdmin();
    }

    // Hospitals Collection (relief_hospitals / hospitals): Anyone authenticated can read verified hospitals
    match /relief_hospitals/{hospitalId} {
      allow read: if true; // Public read for hospital discovery and capacity
      allow create, update: if isAuthenticated() && (isHospital() || isAdmin());
      allow delete: if isAdmin();
    }

    match /hospitals/{hospitalId} {
      allow read: if true;
      allow create, update: if isAuthenticated() && (isHospital() || isAdmin());
      allow delete: if isAdmin();
    }

    // Patients Collection: Patients can access their own profile; Verified doctors can view authorized records
    match /patients/{patientId} {
      allow read: if isAuthenticated() && (request.auth.uid == patientId || isDoctor() || isAdmin());
      allow create: if isAuthenticated() && (request.auth.uid == patientId || isDoctor());
      allow update: if isAuthenticated() && (request.auth.uid == patientId || isDoctor() || isAdmin());
      allow delete: if isAdmin();
    }

    // Referrals Collection (relief_referrals / referrals)
    match /relief_referrals/{referralId} {
      allow read: if isAuthenticated();
      // Only verified doctors can create referrals
      allow create: if isAuthenticated() && (isDoctor() || isAdmin());
      // Doctors, receiving hospitals, and Admins can update status
      allow update: if isAuthenticated() && (isDoctor() || isHospital() || isAdmin());
      allow delete: if isAdmin();
    }

    match /referrals/{referralId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (isDoctor() || isAdmin());
      allow update: if isAuthenticated() && (isDoctor() || isHospital() || isAdmin());
      allow delete: if isAdmin();
    }

    // Notifications Collection (relief_notifications / notifications)
    match /relief_notifications/{notifId} {
      allow read, write: if isAuthenticated();
    }

    match /notifications/{notifId} {
      allow read, write: if isAuthenticated();
    }

    // Bed Reservations Collection: Atomically authorized by hospitals/admins
    match /bedReservations/{reservationId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && (isHospital() || isAdmin());
      allow delete: if isAdmin();
    }

    // Audit Logs
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Immutable logs
    }
  }
}
